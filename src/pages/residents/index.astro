---
export const prerender = false;
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { GET } from "../api/residents/index.ts";
import type { Hero } from "../../data/heroes";
import oldHeroes from "../../assets/old-heroes.jpg";

const response = await GET(Astro);
const residents: Hero[] = await response.json();

const patterns = [
  { href: "/residents/list",          title: "GET — list residents",      blurb: "Fetch JSON from an endpoint." },
  { href: "/residents/join-redirect", title: "A — POST + redirect",       blurb: "Form posts, server redirects." },
  { href: "/residents/join-json",     title: "B — POST + JSON",           blurb: "Form posts via fetch, DOM updates." },
  { href: "/residents/join-action",   title: "C — Astro Action",          blurb: "defineAction + Zod, zero JS." },
];
---

<Layout
  title="Heroes Retirement Home — Astro Playground"
  description="API endpoints & Astro Actions companion playground."
>
  <main class="mx-auto max-w-2xl space-y-10 px-6 py-12">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back
    </a>

    <section class="space-y-4">
      <Image
        src={oldHeroes}
        alt="Two retired superheroes — one in a wheelchair, one stretching with a cane — in yellow and teal costumes."
        width={672}
        loading="eager"
        fetchpriority="high"
        class="w-full rounded-xl border border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900"
      />
      <div class="space-y-2">
        <h1 class="text-3xl font-semibold tracking-tight">Heroes Retirement Home</h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          Companion playground for the <a href="https://dev.jeromeabel.net/blog/api-endpoints-with-astro/" class="underline hover:text-zinc-900 dark:hover:text-zinc-200">blog post on Astro API endpoints</a>. Each link
          below shows one server-side pattern.
        </p>
      </div>
    </section>

    <nav>
      <ul class="space-y-3">
        {patterns.map((p) => (
          <li>
            <a
              href={p.href}
              class="block rounded-lg border border-zinc-200 px-5 py-4 transition-colors hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900"
            >
              <span class="font-medium">{p.title}</span>
              <span class="ml-2 text-sm text-zinc-600 dark:text-zinc-400">{p.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="space-y-3">
      <h2 class="text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">
        Current residents
        <span class="font-normal normal-case text-zinc-400 dark:text-zinc-600">
          ({residents.length})
        </span>
      </h2>
      <ul class="divide-y divide-zinc-200 overflow-hidden rounded-lg border border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
        {residents.map((h) => (
          <li class="flex items-center justify-between px-4 py-3 text-sm">
            <div>
              <span class="font-medium">{h.alias}</span>
              <span class="ml-2 text-xs text-zinc-500 dark:text-zinc-400">retired {h.retiredYear}</span>
            </div>
            <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{h.email}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
