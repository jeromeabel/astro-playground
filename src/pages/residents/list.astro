---
export const prerender = false;
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import type { Hero } from "../../data/heroes";

// Server-side fetch from inside the page frontmatter.
// Equivalent direct-import alternative (no HTTP roundtrip):
//   import { GET } from "../api/residents/index.ts";
//   const response = await GET(Astro);
const response = await fetch(`${Astro.url.origin}/api/residents/`);
const residents: Hero[] = await response.json();

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/heroes/*.jpg"
);

// Pre-resolve all portraits so the template stays synchronous.
const portraits = Object.fromEntries(
  await Promise.all(
    residents.map(async (h) => {
      const key = `/src/assets/heroes/${h.id}.jpg`;
      const portrait = images[key] ? (await images[key]()).default : null;
      return [h.id, portrait] as [number, ImageMetadata | null];
    })
  )
);
---

<Layout title="GET demo — Heroes Retirement Home">
  <main class="mx-auto max-w-2xl space-y-8 px-6 py-12">
    <a
      href="/residents"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back
    </a>

    <section class="space-y-2">
      <h1 class="text-2xl font-semibold">GET — list residents</h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        This page calls
        <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
          /api/residents/
        </code>
        from its frontmatter and renders the JSON server-side.
      </p>
    </section>

    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      {residents.map((h) => (
        <li>
          <a
            href={`/residents/${h.id}`}
            class="block rounded-lg border border-zinc-200 p-2 transition-shadow hover:shadow-md dark:border-zinc-800"
          >
            <HeroPortrait hero={h} portrait={portraits[h.id]} class="aspect-square w-full rounded object-cover" />
            <p class="mt-2 text-center text-sm font-medium">{h.alias}</p>
          </a>
        </li>
      ))}
    </ul>

    <p class="text-xs text-zinc-500 dark:text-zinc-400">
      Try the dynamic API route too:
      <a class="underline hover:text-zinc-900 dark:hover:text-zinc-100" href="/api/residents/2">
        /api/residents/2
      </a>
    </p>
  </main>
</Layout>
