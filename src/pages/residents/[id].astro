---
export const prerender = false;
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import HeroPortrait from "../../components/HeroPortrait.astro";
import type { Hero } from "../../data/heroes";

const { id } = Astro.params;
const res = await fetch(`${Astro.url.origin}/api/residents/${id}`);
if (!res.ok) return Astro.redirect("/404");
const hero: Hero = await res.json();

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/heroes/*.jpg"
);
const key = `/src/assets/heroes/${hero.id}.jpg`;
const portrait = images[key] ? (await images[key]()).default : null;
---

<Layout title={`${hero.alias} — Heroes Retirement Home`}>
  <main class="mx-auto max-w-md space-y-8 px-6 py-12">
    <a
      href="/residents/list"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back to list
    </a>

    <article class="space-y-4">
      <HeroPortrait hero={hero} portrait={portrait} class="aspect-square w-full rounded-xl object-cover" />
      <header class="space-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">{hero.alias}</h1>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">aka {hero.name}</p>
      </header>
      <dl class="space-y-1 text-sm text-zinc-700 dark:text-zinc-300">
        <div>
          <dt class="inline font-medium">Email:</dt>
          <dd class="inline font-mono text-zinc-600 dark:text-zinc-400">{hero.email}</dd>
        </div>
        <div>
          <dt class="inline font-medium">Retired:</dt>
          <dd class="inline">{hero.retiredYear}</dd>
        </div>
      </dl>
    </article>
  </main>
</Layout>
