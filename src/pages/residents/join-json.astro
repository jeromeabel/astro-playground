---
export const prerender = false;
import { heroes, residents } from "@/data/heroes";
import Layout from "@layouts/Layout.astro";
import Icon from "@components/Icon.astro";

// Snapshot current state at page-render time.
// Used to seed client-side tracking so the hint stays accurate
// within the same browser session (no page reloads in Pattern B).
const residentEmails = new Set(residents.map((r) => r.email));
const heroData = heroes.map((h) => ({ id: h.id, email: h.email }));
const firstAccepted = heroes.find((h) => !residentEmails.has(h.email));
const firstSettled = residents[0];
---

<Layout title="B — POST + JSON — Heroes Retirement Home">
  <main class="mx-auto max-w-2xl space-y-8 px-6 py-12">
    <a
      href="/residents"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back
    </a>

    <section class="space-y-2">
      <h1 class="text-2xl font-semibold">B — POST + JSON</h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        A client-side handler intercepts the submit, calls
        <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
          /api/residents/join-json
        </code>, and writes the response message into the page. No navigation.
      </p>
    </section>

    <form method="POST" id="joinForm" class="flex gap-3">
      <label class="sr-only" for="email">Hero email address</label>
      <input
        id="email"
        type="email"
        name="email"
        required
        placeholder="hero@example.com"
        class="flex-1 rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:placeholder-zinc-500 dark:focus:ring-zinc-300"
      />
      <button
        type="submit"
        class="cursor-pointer rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
      >
        Apply
      </button>
    </form>

    {/* No placeholder height — only rendered by JS after first submit, same as Pattern C */}
    <div id="joinFormMessage"></div>

    <p id="joinHint" class="text-xs text-zinc-500 dark:text-zinc-400">
      {firstAccepted ? (
        <>Try <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{firstAccepted.email}</code> (will join),{" "}</>
      ) : (
        <>All heroes have joined! Try{" "}</>
      )}
      <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{firstSettled?.email ?? "bob@super.com"}</code>
      {" "}(already a resident), or{" "}
      <code class="rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">villain@evil.com</code>
      {" "}(rejected).
    </p>

    {/* Server-side data for client-side hint tracking.
        data-* attributes are HTML-encoded by Astro and decoded back by getAttribute(),
        avoiding the set:text + raw-text script tag encoding mismatch. */}
    <div
      id="pageData"
      data-heroes={JSON.stringify(heroData)}
      data-residents={JSON.stringify([...residentEmails])}
      hidden
    ></div>

    <template id="iconCheck">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0" aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <path d="m9 11 3 3L22 4"></path>
      </svg>
    </template>
    <template id="iconInfo">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" class="h-5 w-5 flex-shrink-0" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
    </template>
    <template id="iconAlert">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </template>

    <script>
      type HeroRef = { id: number; email: string };

      const form = document.getElementById("joinForm") as HTMLFormElement;
      const message = document.getElementById("joinFormMessage")!;
      const hint = document.getElementById("joinHint")!;
      const iconCheck = document.getElementById("iconCheck") as HTMLTemplateElement;
      const iconAlert = document.getElementById("iconAlert") as HTMLTemplateElement;

      const pageData = document.getElementById("pageData")!;
      const allHeroes = JSON.parse(pageData.getAttribute("data-heroes")!) as HeroRef[];

      // Track who is settled in this session (server snapshot + new joins)
      const settled = new Set<string>(
        JSON.parse(pageData.getAttribute("data-residents")!) as string[]
      );

      const STYLES = {
        pending: "border-zinc-200 bg-zinc-50 text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400",
        success: "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-300",
        info:    "border-blue-200 bg-blue-50 text-blue-800 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-300",
        error:   "border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-300",
      } as const;

      const iconInfo = document.getElementById("iconInfo") as HTMLTemplateElement;

      const renderMessage = (variant: keyof typeof STYLES, text: string) => {
        const wrapper = document.createElement("div");
        wrapper.className = `flex items-center gap-2 rounded-lg border px-4 py-3 text-sm ${STYLES[variant]}`;
        if (variant === "success") wrapper.appendChild(iconCheck.content.cloneNode(true));
        if (variant === "info")    wrapper.appendChild(iconInfo.content.cloneNode(true));
        if (variant === "error")   wrapper.appendChild(iconAlert.content.cloneNode(true));
        const span = document.createElement("span");
        span.textContent = text;
        wrapper.appendChild(span);
        message.replaceChildren(wrapper);
      };

      const code = (text: string) => {
        const el = document.createElement("code");
        el.className = "rounded bg-zinc-100 px-1 py-0.5 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300";
        el.textContent = text;
        return el;
      };

      // Update the hint to reflect new state: the just-joined hero becomes the
      // "already settled" example; the next available hero becomes "will join".
      const updateHint = (justJoined: string) => {
        const next = allHeroes.find((h) => !settled.has(h.email));
        const parts: (string | Node)[] = next
          ? ["Try ", code(next.email), " (will join), ", code(justJoined), " (already a resident), or ", code("villain@evil.com"), " (rejected)."]
          : ["Everyone has joined! Try ", code(justJoined), " (already a resident) or ", code("villain@evil.com"), " (rejected)."];
        hint.replaceChildren(...parts);
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        renderMessage("pending", "Submitting…");

        const email = String(new FormData(form).get("email") ?? "");
        const wasAlreadySettled = settled.has(email);

        try {
          const response = await fetch("/api/residents/join-json", {
            method: "POST",
            body: new FormData(form),
          });
          const data = (await response.json()) as { ok: boolean; settled?: boolean; msg: string };
          renderMessage(data.ok ? (data.settled ? "info" : "success") : "error", data.msg);

          if (data.ok && !wasAlreadySettled) {
            settled.add(email);
            updateHint(email);
          }
        } catch {
          renderMessage("error", "Network error — try again.");
        }
      });
    </script>
  </main>
</Layout>
