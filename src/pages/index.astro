---
import { actions } from "astro:actions";
import { GET } from "./api/subscribers/index.ts";
import "../styles/global.css";

type Subscriber = {
  id: number;
  name: string;
  email: string;
};

const response = await GET(Astro);
const subscribers: Subscriber[] = await response.json();

const result = Astro.getActionResult(actions.subscribe);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro API Endpoints</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100">
    <main class="max-w-2xl mx-auto px-6 py-16 space-y-16">

      <!-- GET /api/subscribers/ -->
      <section class="space-y-6">
        <div class="space-y-1">
          <p class="text-xs font-mono text-zinc-500 uppercase tracking-widest">GET /api/subscribers/</p>
          <h2 class="text-xl font-semibold">Subscribers</h2>
        </div>
        <ul class="divide-y divide-zinc-800 border border-zinc-800 rounded-lg overflow-hidden">
          {subscribers.slice(0, 5).map((s) => (
            <li class="flex items-center justify-between px-4 py-3 hover:bg-zinc-900 transition-colors">
              <span class="font-medium text-sm">{s.name}</span>
              <span class="text-sm text-zinc-400">{s.email}</span>
            </li>
          ))}
        </ul>
        <p class="text-xs text-zinc-600">
          Data from <a href="https://jsonplaceholder.typicode.com/users" class="underline hover:text-zinc-400">jsonplaceholder.typicode.com</a>
          — fetched via direct handler import (no HTTP round-trip).
        </p>
      </section>

      <!-- POST with redirect — add.ts -->
      <section class="space-y-6">
        <div class="space-y-1">
          <p class="text-xs font-mono text-zinc-500 uppercase tracking-widest">POST /api/subscribers/add — redirect</p>
          <h2 class="text-xl font-semibold">Subscribe (redirect pattern)</h2>
          <p class="text-sm text-zinc-400">Works without JavaScript. Try <code class="bg-zinc-800 px-1 rounded text-xs">steve@rogers.com</code>.</p>
        </div>
        <form method="POST" action="/api/subscribers/add" class="flex gap-3">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="flex-1 bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-2.5 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-500"
          />
          <button
            type="submit"
            class="bg-zinc-100 text-zinc-950 text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-white transition-colors"
          >
            Subscribe
          </button>
        </form>
      </section>

      <!-- POST with JSON — client-side fetch -->
      <section class="space-y-6">
        <div class="space-y-1">
          <p class="text-xs font-mono text-zinc-500 uppercase tracking-widest">POST /api/subscribers/add2 — JSON</p>
          <h2 class="text-xl font-semibold">Subscribe (JSON pattern)</h2>
          <p class="text-sm text-zinc-400">Stays on the page. Requires JavaScript.</p>
        </div>
        <form id="jsonForm" class="flex gap-3">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="flex-1 bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-2.5 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-500"
          />
          <button
            type="submit"
            class="bg-zinc-100 text-zinc-950 text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-white transition-colors"
          >
            Subscribe
          </button>
        </form>
        <p id="jsonMessage" class="text-sm text-zinc-400 hidden"></p>
        <script>
          const form = document.getElementById("jsonForm") as HTMLFormElement;
          const msg = document.getElementById("jsonMessage")!;

          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            try {
              const res = await fetch("/api/subscribers/add2", { method: "POST", body: formData });
              const data = await res.json();
              msg.textContent = data.msg;
              msg.classList.remove("hidden");
            } catch {
              msg.textContent = "An error occurred.";
              msg.classList.remove("hidden");
            }
          });
        </script>
      </section>

      <!-- Astro Actions -->
      <section class="space-y-6">
        <div class="space-y-1">
          <p class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Astro Actions</p>
          <h2 class="text-xl font-semibold">Subscribe (Actions pattern)</h2>
          <p class="text-sm text-zinc-400">Type-safe, Zod-validated, zero-JS fallback built in.</p>
        </div>
        <form method="POST" action={actions.subscribe} class="flex gap-3">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="flex-1 bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-2.5 text-sm placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-500"
          />
          <button
            type="submit"
            class="bg-zinc-100 text-zinc-950 text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-white transition-colors"
          >
            Subscribe
          </button>
        </form>
        {result && !result.error && (
          <p class="text-sm text-zinc-400">{result.data.message}</p>
        )}
        {result?.error && (
          <p class="text-sm text-red-400">{result.error.message}</p>
        )}
      </section>

    </main>
  </body>
</html>
