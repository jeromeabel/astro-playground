---
import "../styles/global.css";

const examples = [
  { href: "/subscribers", title: "Subscribers", description: "API endpoints & Astro Actions" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro Playground</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100">
    <main class="max-w-2xl mx-auto px-6 py-16 space-y-12">

      <section class="space-y-2">
        <h1 class="text-2xl font-semibold">Astro Playground</h1>
        <p class="text-zinc-400 text-sm">A collection of examples exploring Astro features.</p>
      </section>

      <nav>
        <ul class="space-y-3">
          {examples.map((ex) => (
            <li>
              <a href={ex.href} class="block border border-zinc-800 rounded-lg px-5 py-4 hover:bg-zinc-900 transition-colors">
                <span class="font-medium">{ex.title}</span>
                <span class="text-zinc-400 text-sm ml-2">{ex.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </main>
  </body>
</html>
