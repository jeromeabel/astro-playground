---
export const prerender = false;
import Layout from "@layouts/Layout.astro";
import Icon from "@components/Icon.astro";

const reason =
  Astro.url.searchParams.get("reason") ??
  "We could not verify your identity.";
---

<Layout title="Rejected — Heroes Retirement Home">
  <main class="mx-auto max-w-2xl space-y-8 px-6 py-12">
    <a
      href="/residents/join-redirect"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back to A — POST + redirect
    </a>

    <section class="space-y-4">
      <div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-5 py-4 dark:border-red-900 dark:bg-red-950">
        <Icon name="alert-circle" class="h-6 w-6 flex-shrink-0 text-red-600 dark:text-red-400" />
        <div class="space-y-1">
          <h1 class="text-xl font-semibold text-red-900 dark:text-red-200">Application rejected</h1>
          <p class="text-sm text-red-800 dark:text-red-300">{reason}</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
