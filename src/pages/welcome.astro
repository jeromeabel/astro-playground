---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const name = Astro.url.searchParams.get("name") ?? "Hero";
const already = Astro.url.searchParams.get("already") === "1";
const message = already
  ? `${name}, you're already settled in!`
  : `Welcome, ${name}! Your slippers await.`;
---

<Layout title="Welcome — Heroes Retirement Home">
  <main class="mx-auto max-w-2xl space-y-8 px-6 py-12">
    <a
      href="/residents/join-redirect"
      class="inline-flex items-center gap-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
    >
      <Icon name="arrow-left" class="h-4 w-4" /> Back to A — POST + redirect
    </a>

    <section class="space-y-4">
      {already ? (
        <div class="flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 px-5 py-4 dark:border-blue-900 dark:bg-blue-950">
          <Icon name="info" class="h-6 w-6 flex-shrink-0 text-blue-600 dark:text-blue-400" />
          <div class="space-y-1">
            <h1 class="text-xl font-semibold text-blue-900 dark:text-blue-200">{message}</h1>
            <p class="text-sm text-blue-800 dark:text-blue-300">Enjoy the lounge.</p>
          </div>
        </div>
      ) : (
        <div class="flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-5 py-4 dark:border-emerald-900 dark:bg-emerald-950">
          <Icon name="check-circle" class="h-6 w-6 flex-shrink-0 text-emerald-600 dark:text-emerald-400" />
          <div class="space-y-1">
            <h1 class="text-xl font-semibold text-emerald-900 dark:text-emerald-200">{message}</h1>
            <p class="text-sm text-emerald-800 dark:text-emerald-300">Enjoy the lounge.</p>
          </div>
        </div>
      )}
    </section>
  </main>
</Layout>
