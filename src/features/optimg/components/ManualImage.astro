---
// The bash era done right: hand-cut widths + baked blur from public/manual/,
// explicit width/height. Reads approx[plan.ctx] directly (not plan.sizes) so
// pixelPerfect stays a no-op for this source, exactly as before the split.
// MANUAL_WIDTHS is the same array gen-images.mjs bakes to disk — shared via
// scripts/manual-widths.mjs so the two sides can't drift (see that file).
import type { RenderPlan } from "@optimg/lib/render-plan";
import { approx } from "@optimg/lib/sizes";
import { MANUAL_WIDTHS } from "@scripts/manual-widths.mjs";

interface Props {
  plan: RenderPlan;
  id: string; // gallery item id → /manual/<id>-<w>.jpg files
  alt: string;
}

const { plan, id, alt } = Astro.props;
const cover = plan.ctx === "cover";
const srcset = MANUAL_WIDTHS.map((w) => `/manual/${id}-${w}.jpg ${w}w`).join(", ");
---

<img
  src={`/manual/${id}-1280.jpg`}
  srcset={srcset}
  sizes={approx[plan.ctx]}
  width={cover ? 1280 : 640}
  height={cover ? 853 : 427}
  loading={plan.loading}
  fetchpriority={plan.fetchpriority}
  alt={alt}
  class="block w-full bg-cover"
  style={`background-image:url(/manual/${id}-blur.jpg)`}
/>
