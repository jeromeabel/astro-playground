---
// Placeholder box behind an image: "none" renders only the slot; "skeleton"
// is a static grey box; "lqip" is an inlined base64 blurred <img>, with the
// cache-guarded fade (scripts/reveal-img.ts) wired via the `reveal-img`
// class when `fade` is set. Deliberately dumb: the caller decides the kind —
// this component never inspects Options or a RenderPlan.
//
// `placeholder` only exists (and is required) on the "lqip" branch — a
// discriminated union so the caller can't pass kind:"lqip" without a
// placeholder, or a placeholder on a kind that ignores it, and get away with
// it at compile time. Exported so callers (PictureImage) can type their own
// dispatch object against exactly this shape.
export type Props =
  | { kind: "none"; fade: boolean }
  | { kind: "skeleton"; fade: boolean }
  | { kind: "lqip"; placeholder: string; fade: boolean };

const props = Astro.props;
const { kind, fade } = props;
const placeholder = props.kind === "lqip" ? props.placeholder : undefined;
---

{kind === "none" && <slot />}

{kind === "skeleton" && (
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 h-full w-full bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
    <slot />
  </div>
)}

{kind === "lqip" && (
  <div class={fade ? "reveal-img relative overflow-hidden" : "relative overflow-hidden"}>
    <img
      class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
      aria-hidden="true"
      src={placeholder}
      alt=""
    />
    <slot />
  </div>
)}
