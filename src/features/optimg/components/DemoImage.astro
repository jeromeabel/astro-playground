---
import { readFile } from "node:fs/promises";
import sharp from "sharp";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { GalleryItem } from "@optimg/data/gallery";
import type { Strategy } from "@optimg/lib/strategies";
import { exact, approx } from "@optimg/lib/sizes";

interface Props {
  item: GalleryItem;
  strategy: Strategy;
  type: "thumb" | "cover";
  image?: ImageMetadata; // required for every strategy except "manual"
  index?: number; // grid position; omit to keep caller lazy by default
}

const { item, strategy, type, image, index } = Astro.props;

// Viewport is unknown at build time (static prerender, no Client Hints on first
// nav) so EAGER_AHEAD is a fixed worst-case constant: 6 covers mobile 1-col (3
// above fold) and md/lg 2–3-col (2 rows = 6). Over-eager on mobile costs ~2
// small thumbs; lazy-on-LCP hurts LCP. Bias high.
const EAGER_AHEAD = 6;

// undefined index (caller omitted it) → Infinity → safely below-fold.
function isAboveFold(i: number | undefined): boolean {
  return (i ?? Infinity) < EAGER_AHEAD;
}

const isCover = type === "cover";
const isLCP = !isCover && index === 0;
const loading = (isCover || isAboveFold(index)) ? "eager" : "lazy";
// fetchpriority="high" is a scalpel — exactly one element (the LCP). Spreading
// it across the whole above-fold row dilutes the signal and hurts LCP.
const fetchpriority = (isCover || isLCP) ? "high" : "auto";
const width = isCover ? 1280 : 640;
const height = isCover ? 853 : 427; // 3:2

// Props every <Picture> block shares. Per-strategy differences (widths, sizes,
// fit, position, width, height, pictureAttributes) stay inline so each block
// still reads as a self-contained demo of its technique. `layout` stays inline
// per block too: it's the discriminant of Astro's <Picture> prop union, and
// spreading it would stop TypeScript from selecting the constrained variant
// (where `height` is optional).
const baseProps: {
  formats: ("avif" | "webp")[];
  loading: "lazy" | "eager";
  fetchpriority: "high" | "auto";
  alt: string;
  class: string;
} = {
  formats: ["avif", "webp"],
  loading,
  fetchpriority,
  alt: item.alt,
  class: "block w-full",
};

// Pick the layout context once; auto/lqip use the approximate (vw) sizes,
// pixel-perfect uses the token-derived sizes + widths so a generated file lands
// exactly on the slot (no resampling).
const ctx = isCover ? "cover" : "grid";
const autoSizes = approx[ctx];
const { sizes: ppSizes, widths: ppWidths, width: ppWidth } = exact[ctx];

// "final" = LQIP + fade + pixel-perfect widths. Crop is opt-in per gallery item
// (default off → natural 3:2); when set, wide 16:9 cover / square-ish 4:3 thumb.
const finalCrop = strategy === "final" && item.crop === true;
const [cropW, cropH] = isCover ? [16, 9] : [4, 3];
const finalHeight = finalCrop ? Math.round((ppWidth * cropH) / cropW) : undefined;

// LQIP/final: build a tiny blurred placeholder at build time, matching the
// displayed aspect so it doesn't distort behind the real image. Inlined as a
// base64 data: URI (not a getImage() URL) so it paints on the first frame with
// zero network requests — getImage()'s emitted asset isn't written to disk
// until Astro's post-render image-generation pass, so there's no file to read
// yet at this point in the pipeline. Instead we go straight to sharp (already
// a dependency, same library Astro's own image service uses) over the source
// file's real fs path, exposed by astro:assets as the non-enumerable
// `fsPath` on ImageMetadata (not in its public type, hence the cast).
let placeholder: string | undefined;
if ((strategy === "lqip" || strategy === "final") && image) {
  const [aw, ah] = finalCrop ? [cropW, cropH] : [3, 2];
  const fsPath = (image as unknown as { fsPath: string }).fsPath;
  const srcBuffer = await readFile(fsPath);
  const lqBuffer = await sharp(srcBuffer)
    .resize(32, Math.round((32 * ah) / aw), finalCrop ? { fit: "cover" } : undefined)
    .webp()
    .toBuffer();
  placeholder = `data:image/webp;base64,${lqBuffer.toString("base64")}`;
}
---

{
  strategy === "naive" && image && (
    /* floor: no srcset, no sizes, no width/height -> worst bytes + CLS */
    <img src={image.src} alt={item.alt} class="block w-full" />
  )
}

{
  strategy === "manual" && (
    /* bash era done right: hand-cut widths + baked blur, manual width/height */
    <img
      src={`/manual/${item.id}-1280.jpg`}
      srcset={`/manual/${item.id}-640.jpg 640w, /manual/${item.id}-960.jpg 960w, /manual/${item.id}-1280.jpg 1280w, /manual/${item.id}-1920.jpg 1920w`}
      sizes={autoSizes}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      alt={item.alt}
      class="block w-full bg-cover"
      style={`background-image:url(/manual/${item.id}-blur.jpg)`}
    />
  )
}

{
  strategy === "auto" && image && (
    /* toil deletion: formats + srcset + sizes + auto width/height (CLS fixed) */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={width}
      sizes={autoSizes}
    />
  )
}

{
  strategy === "pixel-perfect" && image && (
    /* widths + sizes from layout tokens (incl. the 1px border) -> the served file
       lands on the slot at 1x and 2x, so the browser never resamples hard edges */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={ppWidth}
      widths={ppWidths}
      sizes={ppSizes}
    />
  )
}

{
  strategy === "cropped" && image && (
    /* one source, two build-time crops: 4:3 thumb vs 16:9 cover, both fit=cover */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={isCover ? 1280 : 640}
      height={isCover ? 720 : 480}
      fit="cover"
      sizes={autoSizes}
    />
  )
}

{
  strategy === "lqip" && image && (
    /* separate 32px blurred <img> behind a real <Picture> that starts invisible
       and fades in on load (reveal-img.ts, cache-guarded). The placeholder is its
       own positioned box, so it paints the full slot on the first frame — LCP fires
       on it instead of the streaming file. */
    <div class="reveal-img relative overflow-hidden">
      <img
        class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
        aria-hidden="true"
        src={placeholder}
        alt=""
      />
      <Picture
        src={image}
        layout="constrained"
        {...baseProps}
        width={width}
        sizes={autoSizes}
        pictureAttributes={{ style: "opacity:0" }}
      />
    </div>
  )
}

{
  strategy === "final" && image && (
    /* the production strategy: LQIP placeholder + cache-guarded fade, over a
       pixel-perfect <Picture> (token widths land the file on the slot, no
       resampling). Natural 3:2 by default; optional per-context crop (16:9 cover
       / 4:3 thumb) when item.crop is set. */
    <div class="reveal-img relative overflow-hidden">
      <img
        class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
        aria-hidden="true"
        src={placeholder}
        alt=""
      />
      <Picture
        src={image}
        layout="constrained"
        {...baseProps}
        width={ppWidth}
        widths={ppWidths}
        height={finalHeight}
        fit={finalCrop ? "cover" : undefined}
        position={finalCrop ? "top" : undefined}
        sizes={ppSizes}
        pictureAttributes={{ style: "opacity:0" }}
      />
    </div>
  )
}
