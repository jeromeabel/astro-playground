---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { GalleryItem } from "@optimg/data/gallery";
import type { Strategy } from "@optimg/lib/strategies";
import {
  gridSizes,
  detailSizes,
  pixelPerfectGridSizes,
  pixelPerfectGridWidths,
  pixelPerfectGridWidth,
  pixelPerfectCoverSizes,
  pixelPerfectCoverWidths,
  pixelPerfectCoverWidth,
} from "@optimg/lib/sizes";

interface Props {
  item: GalleryItem;
  strategy: Strategy;
  type: "thumb" | "cover";
  image?: ImageMetadata; // required for every strategy except "manual"
}

const { item, strategy, type, image } = Astro.props;

const isCover = type === "cover";
const loading = isCover ? "eager" : "lazy";
const fetchpriority = isCover ? "high" : "auto";
const width = isCover ? 1280 : 640;
const height = isCover ? 853 : 427; // 3:2

// Props every <Picture> block shares. Per-strategy differences (widths, sizes,
// fit, position, width, height, pictureAttributes) stay inline so each block
// still reads as a self-contained demo of its technique. `layout` stays inline
// per block too: it's the discriminant of Astro's <Picture> prop union, and
// spreading it would stop TypeScript from selecting the constrained variant
// (where `height` is optional).
const baseProps: {
  formats: ("avif" | "webp")[];
  loading: "lazy" | "eager";
  fetchpriority: "high" | "auto";
  alt: string;
  class: string;
} = {
  formats: ["avif", "webp"],
  loading,
  fetchpriority,
  alt: item.alt,
  class: "block w-full",
};

// auto + lqip use the approximate default; pixel-perfect uses token-derived
// sizes + widths so a generated file lands exactly on the slot (no resampling).
const autoSizes = isCover ? detailSizes : gridSizes;
const ppSizes = isCover ? pixelPerfectCoverSizes : pixelPerfectGridSizes;
const ppWidths = isCover ? pixelPerfectCoverWidths : pixelPerfectGridWidths;
const ppWidth = isCover ? pixelPerfectCoverWidth : pixelPerfectGridWidth;

// "final" = LQIP + fade + pixel-perfect widths. Crop is opt-in per gallery item
// (default off → natural 3:2); when set, wide 16:9 cover / square-ish 4:3 thumb.
const finalCrop = strategy === "final" && item.crop === true;
const [cropW, cropH] = isCover ? [16, 9] : [4, 3];
const finalHeight = finalCrop ? Math.round((ppWidth * cropH) / cropW) : undefined;

// LQIP/final: build a tiny blurred placeholder at build time, matching the
// displayed aspect so it doesn't distort behind the real image.
let placeholder: string | undefined;
if ((strategy === "lqip" || strategy === "final") && image) {
  const [aw, ah] = finalCrop ? [cropW, cropH] : [3, 2];
  const lq = await getImage({
    src: image,
    width: 32,
    height: Math.round((32 * ah) / aw),
    format: "webp",
    ...(finalCrop ? { fit: "cover" } : {}),
  });
  placeholder = lq.src;
}
---

{
  strategy === "naive" && image && (
    /* floor: no srcset, no sizes, no width/height -> worst bytes + CLS */
    <img src={image.src} alt={item.alt} class="block w-full" />
  )
}

{
  strategy === "manual" && (
    /* bash era done right: hand-cut widths + baked blur, manual width/height */
    <img
      src={`/manual/${item.id}-1280.jpg`}
      srcset={`/manual/${item.id}-640.jpg 640w, /manual/${item.id}-960.jpg 960w, /manual/${item.id}-1280.jpg 1280w, /manual/${item.id}-1920.jpg 1920w`}
      sizes={autoSizes}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      alt={item.alt}
      class="block w-full bg-cover"
      style={`background-image:url(/manual/${item.id}-blur.jpg)`}
    />
  )
}

{
  strategy === "auto" && image && (
    /* toil deletion: formats + srcset + sizes + auto width/height (CLS fixed) */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={width}
      sizes={autoSizes}
    />
  )
}

{
  strategy === "pixel-perfect" && image && (
    /* widths + sizes from layout tokens (incl. the 1px border) -> the served file
       lands on the slot at 1x and 2x, so the browser never resamples hard edges */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={ppWidth}
      widths={ppWidths}
      sizes={ppSizes}
    />
  )
}

{
  strategy === "cropped" && image && (
    /* one source, two build-time crops: 4:3 thumb vs 16:9 cover, both fit=cover */
    <Picture
      src={image}
      layout="constrained"
      {...baseProps}
      width={isCover ? 1280 : 640}
      height={isCover ? 720 : 480}
      fit="cover"
      sizes={autoSizes}
    />
  )
}

{
  strategy === "lqip" && image && (
    /* separate 32px blurred <img> behind a real <Picture> that starts invisible
       and fades in on load (reveal-img.ts, cache-guarded). The placeholder is its
       own positioned box, so it paints the full slot on the first frame — LCP fires
       on it instead of the streaming file. */
    <div class="reveal-img relative overflow-hidden">
      <img
        class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
        aria-hidden="true"
        src={placeholder}
        alt=""
      />
      <Picture
        src={image}
        layout="constrained"
        {...baseProps}
        width={width}
        sizes={autoSizes}
        pictureAttributes={{ style: "opacity:0" }}
      />
    </div>
  )
}

{
  strategy === "final" && image && (
    /* the production strategy: LQIP placeholder + cache-guarded fade, over a
       pixel-perfect <Picture> (token widths land the file on the slot, no
       resampling). Natural 3:2 by default; optional per-context crop (16:9 cover
       / 4:3 thumb) when item.crop is set. */
    <div class="reveal-img relative overflow-hidden">
      <img
        class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
        aria-hidden="true"
        src={placeholder}
        alt=""
      />
      <Picture
        src={image}
        layout="constrained"
        {...baseProps}
        width={ppWidth}
        widths={ppWidths}
        height={finalHeight}
        fit={finalCrop ? "cover" : undefined}
        position={finalCrop ? "top" : undefined}
        sizes={ppSizes}
        pictureAttributes={{ style: "opacity:0" }}
      />
    </div>
  )
}
