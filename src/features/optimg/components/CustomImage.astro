---
// Dispatcher: resolve options → derive the plan → hand the plan to the
// adapter for its source. Markup varies on the `source` axis (3 shapes), not
// the strategy id (7 names) — see .specs/2026-07-05-optimg-deepening/design.md C5.
import type { ImageMetadata } from "astro";
import type { GalleryItem } from "@optimg/data/gallery";
import type { Strategy, Options } from "@optimg/lib/strategies";
import { resolveOptions } from "@optimg/lib/strategies";
import { renderPlan } from "@optimg/lib/render-plan";
import RawImage from "./RawImage.astro";
import ManualImage from "./ManualImage.astro";
import PictureImage from "./PictureImage.astro";

interface Props {
  item: GalleryItem;
  type: "thumb" | "cover";
  image?: ImageMetadata; // required for every source except "public"
  index?: number; // grid position; omit to keep caller lazy by default
  strategy?: Strategy;
  options?: Partial<Options>;
}

const { item, type, image, index, strategy, options } = Astro.props;

// Routes keep passing `strategy` (minimal churn); tests can pass a raw
// `options` bundle instead to exercise the option matrix directly. With no
// strategy, unset fields fall back to the "auto" bundle (plain picture, no
// enhancements).
const opts: Options = resolveOptions(strategy ?? "auto", options);

const plan = renderPlan(opts, {
  ctx: type === "cover" ? "cover" : "grid",
  index,
  itemCrop: item.crop,
});
---

{plan.source === "raw" && image && <RawImage image={image} alt={item.alt} />}

{plan.source === "public" && <ManualImage plan={plan} id={item.id} alt={item.alt} />}

{plan.source === "picture" && image && <PictureImage plan={plan} image={image} alt={item.alt} />}
