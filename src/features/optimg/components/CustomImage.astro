---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { GalleryItem } from "@optimg/data/gallery";
import type { Strategy, Options } from "@optimg/lib/strategies";
import { resolveOptions } from "@optimg/lib/strategies";
import { renderPlan } from "@optimg/lib/render-plan";
import { buildLqip } from "@optimg/lib/lqip";
import { approx } from "@optimg/lib/sizes";

interface Props {
  item: GalleryItem;
  type: "thumb" | "cover";
  image?: ImageMetadata; // required for every source except "public"
  index?: number; // grid position; omit to keep caller lazy by default
  strategy?: Strategy;
  options?: Partial<Options>;
}

const { item, type, image, index, strategy, options } = Astro.props;

// Routes keep passing `strategy` (minimal churn); tests can pass a raw
// `options` bundle instead to exercise the option matrix directly. With no
// strategy, unset fields fall back to the "auto" bundle (plain picture, no
// enhancements).
const opts: Options = resolveOptions(strategy ?? "auto", options);

// Every render decision — loading, fetchpriority, fade, sizes/widths, crop
// geometry, placeholder flags — is derived by the pure seam. This component
// only wires the plan into markup.
const plan = renderPlan(opts, {
  ctx: type === "cover" ? "cover" : "grid",
  index,
  itemCrop: item.crop,
});

// The one async side-effect: inline base64 LQIP, built only when the plan
// asks for it and a real image is present.
const placeholder = plan.needsLqip && image ? await buildLqip(image, plan) : undefined;
const showLqip = placeholder !== undefined;

// Props every <Picture> block shares. `layout` stays inline: it's the
// discriminant of Astro's <Picture> prop union, and spreading it would stop
// TypeScript from selecting the constrained variant (where `height` is
// optional).
const baseProps: {
  formats: ("avif" | "webp")[];
  loading: "lazy" | "eager";
  fetchpriority: "high" | "auto";
  alt: string;
  class: string;
} = {
  formats: ["avif", "webp"],
  loading: plan.loading,
  fetchpriority: plan.fetchpriority,
  alt: item.alt,
  class: "block w-full",
};

// Opt-in hook attribute for img-audit.ts style tooling.
const pictureAttributes = plan.debug ? { "data-optimg-debug": "true" } : {};
---

{
  plan.source === "raw" && image && (
    /* floor: no srcset, no sizes, no width/height -> worst bytes + CLS */
    <img src={image.src} alt={item.alt} class="block w-full" />
  )
}

{
  plan.source === "public" && (
    /* bash era done right: hand-cut widths + baked blur, manual width/height */
    <img
      src={`/manual/${item.id}-1280.jpg`}
      srcset={`/manual/${item.id}-640.jpg 640w, /manual/${item.id}-960.jpg 960w, /manual/${item.id}-1280.jpg 1280w, /manual/${item.id}-1920.jpg 1920w`}
      sizes={approx[plan.ctx]}
      width={plan.ctx === "cover" ? 1280 : 640}
      height={plan.ctx === "cover" ? 853 : 427}
      loading={plan.loading}
      fetchpriority={plan.fetchpriority}
      alt={item.alt}
      class="block w-full bg-cover"
      style={`background-image:url(/manual/${item.id}-blur.jpg)`}
    />
  )
}

{
  plan.source === "picture" && image && (
    showLqip ? (
      <div class={plan.fade ? "reveal-img relative overflow-hidden" : "relative overflow-hidden"}>
        <img
          class="absolute inset-0 -z-10 h-full w-full object-cover blur-2xl"
          aria-hidden="true"
          src={placeholder}
          alt=""
        />
        <Picture
          src={image}
          layout="constrained"
          {...baseProps}
          width={plan.width}
          widths={plan.widths}
          height={plan.height}
          fit={plan.fit}
          position={plan.position}
          sizes={plan.sizes}
          pictureAttributes={plan.fade ? { ...pictureAttributes, style: "opacity:0" } : pictureAttributes}
        />
      </div>
    ) : plan.showSkeleton ? (
      <div class="relative overflow-hidden">
        <div class="absolute inset-0 -z-10 h-full w-full bg-zinc-200 dark:bg-zinc-800" aria-hidden="true" />
        <Picture
          src={image}
          layout="constrained"
          {...baseProps}
          width={plan.width}
          widths={plan.widths}
          height={plan.height}
          fit={plan.fit}
          position={plan.position}
          sizes={plan.sizes}
          pictureAttributes={pictureAttributes}
        />
      </div>
    ) : (
      <Picture
        src={image}
        layout="constrained"
        {...baseProps}
        width={plan.width}
        widths={plan.widths}
        height={plan.height}
        fit={plan.fit}
        position={plan.position}
        sizes={plan.sizes}
        pictureAttributes={pictureAttributes}
      />
    )
  )
}
