---
// Generic breadcrumb trail. The last item is rendered as the current page
// (non-link) regardless of href, so callers can pass a uniform item list.
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-zinc-500 dark:text-zinc-500">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="transition-colors hover:text-zinc-900 hover:underline dark:hover:text-zinc-100"
              >
                {item.label}
              </a>
            ) : (
              <span
                aria-current={isLast ? "page" : undefined}
                class="font-medium text-zinc-700 dark:text-zinc-300"
              >
                {item.label}
              </span>
            )}
            {!isLast && <span aria-hidden="true" class="text-zinc-300 dark:text-zinc-700">/</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
